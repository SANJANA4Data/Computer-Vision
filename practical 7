import cv2
import numpy as np
from google.colab.patches import cv2_imshow

cap = cv2.VideoCapture("bike_shot.mp4")

ret, frame1 = cap.read()
if not ret:
    print("Error: Could not read video file.")
else:
    prvs = cv2.cvtColor(frame1, cv2.COLOR_BGR2GRAY)
    hsv = np.zeros_like(frame1)
    hsv[..., 1] = 255  # saturation

    while True:
        ret, frame2 = cap.read()
        if not ret:
            break

        next_gray = cv2.cvtColor(frame2, cv2.COLOR_BGR2GRAY)
        flow = cv2.calcOpticalFlowFarneback(prvs, next_gray, None,
                                            0.5, 3, 15, 3, 5, 1.2, 0)

        mag, ang = cv2.cartToPolar(flow[..., 0], flow[..., 1])
        hsv[..., 0] = ang * 180 / np.pi / 2
        hsv[..., 2] = cv2.normalize(mag, None, 0, 255, cv2.NORM_MINMAX)

        rgb = cv2.cvtColor(hsv, cv2.COLOR_HSV2BGR)

        # Blend optical flow visualization with original frame
        overlay = cv2.addWeighted(frame2, 0.7, rgb, 0.3, 0)

        cv2_imshow(overlay)  # show inline in Colab

        prvs = next_gray

cap.release()
